# ============================================================
# HTML to APK — Environment Variables Template
# Copy this file to .env and fill in your real values
# ============================================================

# Telegram
API_ID=your_telegram_api_id
API_HASH=your_telegram_api_hash
BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ADMIN_CHAT_ID=your_telegram_chat_id
BOT_USERNAME=your_bot_username

# GitHub
GITHUB_REPO=abuhoney/html-to-apk
GITHUB_BRANCH=main
GITHUB_TOKEN=your_github_pat
HF_TOKEN=your_huggingface_token

# Render
RENDER_API_KEY=your_render_api_key
RENDER_SERVICE_ID=your_render_service_id

# Backend (live Render service)
BACKEND_URL=https://html-to-apk-1789777001.onrender.com
BACKEND_SECRET=your_secret_here
NODE_ENV=production
PORT=10000

# Firebase
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_APP_ID=your_firebase_app_id
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your_project-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=your_project_id

AUTO_PUSH_GITHUB=true
